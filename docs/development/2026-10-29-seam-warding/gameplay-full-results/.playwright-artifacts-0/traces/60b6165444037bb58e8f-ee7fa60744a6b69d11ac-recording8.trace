p { flex-basis: 100%; }\n.application.campaign-session .campaign { display: block; flex: 1 1 auto; height: auto; min-height: 260px; width: 100%; }\n.application.campaign-session .campaign > .map-section { height: 100%; min-height: 0; width: 100%; border: 0; }\n.application .campaign:not(.battle-active) .map-host { position: absolute; inset: 0; height: 100%; width: 100%; }\n.application .map-title { left: 20px; top: 15px; padding: 10px 14px; pointer-events: none; }\n.application .map-order-hint { top: 96px; left: 20px; max-width: min(420px,calc(100% - 160px)); }\n.application .map-compass { display: none; }\n.application .map-legend { display: none; }\n.hud-tools { position: absolute; top: 15px; right: 16px; z-index: 4; display: flex; flex-direction: column; gap: 6px; padding: 7px; max-height: calc(100% - 94px); overflow: auto; scrollbar-width: thin; overscroll-behavior: contain; border-radius: 8px; }\n.hud-tools > button { display: flex; align-items: center; gap: 10px; width: 146px; min-height: 44px; padding: 8px 10px; text-align: left; font-size: calc(12px * var(--text-scale,1)); line-height: 1.3; }\n.hud-icon { width: 24px; height: 24px; flex: none; }\n.application .map-controls { left: 18px; bottom: 16px; z-index: 4; gap: 5px; padding: 5px; border-radius: 6px; max-width: calc(100% - 36px); }\n.application .campaign .map-controls > button { min-height: 44px; font-size: calc(12px * var(--text-scale,1)); }\n.application .campaign .map-controls > button[aria-label=\"Map guide\"] { width: 44px; padding: 8px; }\n.application .command-bar { position: relative; bottom: auto; flex: none; display: grid; grid-template-columns: minmax(240px,1fr) auto auto; align-items: center; gap: 10px 22px; padding: 12px 22px 0; min-height: 0; }\n.hud-selection { display: flex; align-items: center; gap: 13px; min-width: 0; }\n.hud-selection > .faction-art { flex: none; }\n.hud-selection-copy { min-width: 0; }\n.hud-selection-copy > small,.hud-selection-copy > strong,.hud-selection-copy > span { display: block; }\n.hud-selection-copy > small { text-transform: uppercase; letter-spacing: .13em; font-size: calc(10px * var(--text-scale,1)); }\n.hud-selection-copy > strong { font: calc(19px * var(--text-scale,1))/1.3 Georgia,serif; overflow-wrap: anywhere; }\n.hud-selection-copy > span { font-size: calc(12px * var(--text-scale,1)); }\n.hud-selection-actions { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }\n.hud-selection-actions button { min-height: 44px; font-size: calc(12px * var(--text-scale,1)); padding: 8px 12px; }\n.hud-next-actions { min-width: 0; }\n.hud-next-actions > div { display: grid; grid-template-columns: 44px auto 44px auto; gap: 5px; margin-top: 7px; }\n.hud-next-actions button { min-height: 44px; padding: 8px; font-size: calc(12px * var(--text-scale,1)); }\n.hud-next-actions [data-testid=\"next-action-notice\"] { display: block; max-width: 330px; overflow-wrap: anywhere; }\n.hud-next-actions .field-help { font-size: calc(11px * var(--text-scale,1)); }\n.hud-next-actions > .hud-household-actions { grid-template-columns: 44px minmax(0,1fr); }\n.hud-next-actions [data-testid=\"household-counts\"] { margin: 6px 0 0; overflow-wrap: anywhere; }\n.hud-action-causes { margin-top: 7px; max-width: 330px; }\n.hud-action-causes > summary { min-height: 40px; padding: 10px 0; cursor: pointer; font-size: calc(12px * var(--text-scale,1)); }\n.hud-action-causes > summary > span { float: right; font-size: calc(10px * var(--text-scale,1)); color: #b6c2a4; line-height: 2; }\n.hud-action-causes > button { display: block; width: 100%; margin-bottom: 5px; text-align: left; overflow-wrap: anywhere; }\n.hud-action-causes > summary:focus-visible { outline: 2px solid #c9af73; outline-offset: 2px; }\n.hud-end-turn { display: flex; gap: 14px; align-items: center; justify-content: flex-end; }\n.application .hud-end-turn .turn { min-width: 70px; margin: 0; text-align: center; }\n.application .hud-end-turn .turn strong { font-size: calc(23px * var(--text-scale,1)); }\n.application .hud-end-turn .end-turn { min-width: 125px; min-height: 60px; padding: 12px 16px; }\n.application .command-bar .feedback { grid-column: 1/-1; width: 100%; padding: 7px 0; font-size: calc(12px * var(--text-scale,1)); gap: 9px; }\n.application .command-bar .feedback .status-mark { font-size: 10px; }\n.application .art-dev-launch { flex: none; padding: 3px 12px; font-size: 10px; min-height: 0; }\n.application .art-dev-launch button { padding: 2px 8px; min-height: 24px; font-size: 10px; }\n.campaign-window { width: min(860px,calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px); padding: 0; margin: auto; overflow: hidden; font-size: calc(14px * var(--text-scale,1)); }\n.campaign-window[open] { display: flex; flex-direction: column; }\n.campaign-window::backdrop { background: #100b086b; }\n.campaign-window-header { display: flex; align-items: flex-start; justify-content: space-between; flex: none; gap: 18px; padding: 20px 22px; }\n.campaign-window-header > div { min-width: 0; padding-right: 40px; }\n.campaign-window-header h2 { margin: 5px 0; overflow-wrap: anywhere; }\n.campaign-window-header p { font-size: .85em; }\n.campaign-window-header > button { width: 44px; min-height: 44px; padding: 0; font-size: 25px; flex: none; }\n.campaign-window-body { min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; padding: 20px 24px 24px; }\n.campaign-window :is(button,input,select,summary) { min-height: 44px; scroll-margin-block: 12px; }\n.campaign-window input[type=checkbox] { min-height: 20px; }\n.campaign-window :is(.inspector,.strategic-orders) { padding: 0; margin: 0; border: 0; min-width: 0; }\n.campaign-window .window-map-link { display: block; margin: 0 0 16px; }\n.campaign-window .inspector h2 { font-size: calc(25px * var(--text-scale,1)); }\n.campaign-window .registry { max-height: none; overflow: visible; }\n.campaign-window .registry-item { min-height: 66px; }\n.campaign-window .registry-item strong { font-size: 1em; }\n.campaign-window .registry-item small { font-size: .85em; }\n.campaign-window .realm-command-strip { margin: 14px 0; }\n.campaign-window .chronicle { margin: 0; padding: 0; }\n.campaign-window .chronicle ol { max-height: none; }\n.campaign-window .battle-history { margin: 0; }\n.map-guide p { margin: 14px 0 22px; line-height: 1.8; }\n.army-quick-actions { display: grid; gap: 8px; }\n.army-quick-actions .found-form { margin-top: 0; }\n.army-quick-actions .found-form .field-help { display: none; }\n.army-quick-links { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }\n.army-quick-links button { padding: 8px; font-size: .92em; }\n/* Battles retain their tested document-flow field and responsive order deck. */\n.application.campaign-session:has(.battle-active) { height: auto; }\n.application.campaign-session .campaign.battle-active { flex: none; height: auto; min-height: 0; }\n.application.campaign-session .campaign.battle-active > .map-section { height: auto; }\n.battle-active .hud-tools { display: none; }\n/* Capture is a blocking decision, above map tools (4) and the overview (6). */\n.application .capture-panel { z-index: 7; }\n@media(max-width:1100px) {\n  .hud-realm { display: none; }\n  .application .command-bar { grid-template-columns: minmax(220px,1fr) auto; gap: 10px 16px; }\n  .hud-next-actions { grid-column: 1; grid-row: 2; }\n  .hud-end-turn { grid-column: 2; grid-row: 1/3; }\n  .hud-next-actions > div { grid-template-columns: 44px minmax(70px,1fr) 44px minmax(70px,1fr); }\n}\n@media(max-width:650px) {\n  .application.campaign-session { min-height: 600px; }\n  .application .masthead { min-height: 60px; padding: 9px 12px; gap: 12px; }\n  .application .masthead .crest { display: none; }\n  .application .wordmark h1 { font-size: calc(20px * var(--text-scale,1)); letter-spacing: 1px; }\n  .application .wordmark .eyebrow { display: none; }\n  .application .resources { gap: 13px; }\n  .application .resources > div { min-width: 0; }\n  .application .resources > div:last-child { display: none; }\n  .application .resources strong { font-size: calc(17px * var(--text-scale,1)); }\n  .application .resources small { font-size: 9px; }\n  .application .campaign-tools { padding: 3px 172px 3px 12px; min-height: 44px; }\n  .application .campaign-tools .archive-note { display: none; }\n  .application .campaign-options { right: 4px; }\n  .application .campaign-options > summary { padding-inline: 8px; font-size: calc(11px * var(--text-scale,1)); }\n  .application .campaign-options .options-content { right: 4px; grid-template-columns: 1fr; width: calc(100vw - 16px); padding: 16px; }\n  .application .watch-controls { width: calc(100vw - 24px); flex: none; }\n  .application .campaign-tools:has(.watch-controls) { padding-right: 12px; padding-bottom: 44px; }\n  .application .campaign-tools:has(.watch-controls) > .campaign-pace { margin-bottom: 4px; }\n  .application .map-title { display: none; }\n  .application .hud-tools { flex-direction: row; top: 9px; left: 9px; right: 9px; padding: 4px; max-height: none; gap: 4px; border-radius: 5px; }\n  .hud-tools > button { width: 80px; flex: none; flex-direction: column; gap: 4px; padding: 6px; min-height: 64px; text-align: center; font-size: calc(11px * var(--text-scale,1)); }\n  .hud-tools .hud-icon { width: 21px; height: 21px; }\n  .application .map-order-hint { top: 94px; left: 12px; max-width: calc(100% - 24px); padding: 6px 9px; font-size: calc(10px * var(--text-scale,1)); }\n  .application .map-order-hint > span { display: none; }\n  .application .map-controls { left: 8px; bottom: 8px; max-width: calc(100% - 16px); flex-wrap: nowrap; overflow-x: auto; }\n  .application .map-controls > button { flex: none; }\n  .application .command-bar { padding: 9px 12px 0; gap: 8px; grid-template-columns: minmax(0,1fr) 105px; }\n  .hud-selection { gap: 6px; }\n  .hud-selection > .faction-art { display: none; }\n  .hud-selection-copy > strong { font-size: calc(16px * var(--text-scale,1)); }\n  .hud-selection-copy > span { font-size: calc(10px * var(--text-scale,1)); }\n  .hud-selection-actions { margin-top: 5px; gap: 4px; }\n  .hud-selection-actions button { padding: 6px 8px; font-size: calc(11px * var(--text-scale,1)); }\n  .hud-selection-actions button + button { display: none; }\n  .hud-end-turn { flex-direction: column; gap: 4px; grid-row: 1; }\n  .application .hud-end-turn .end-turn { min-width: 0; width: 100%; min-height: 52px; padding: 8px; }\n  .application .hud-end-turn .turn strong { font-size: calc(21px * var(--text-scale,1)); }\n  .hud-end-turn .turn small { display: none; }\n  .hud-next-actions { grid-column: 1/-1; grid-row: 2; }\n  .hud-next-actions > div { margin: 0; gap: 4px; }\n  .hud-next-actions [data-testid=next-action-counts] { display: none; }\n  .hud-next-actions [data-testid=next-action-notice]:empty { display: none; }\n  .application .command-bar .feedback { padding: 5px 0; font-size: calc(10px * var(--text-scale,1)); }\n  .campaign-window { width: calc(100vw - 16px); max-height: calc(100dvh - 16px); }\n  .campaign-window-header { padding: 14px; gap: 10px; }\n  .campaign-window-header > div { padding-right: 0; }\n  .campaign-window-header h2 { font-size: calc(24px * var(--text-scale,1)); }\n  .campaign-window-body { padding: 14px; }\n  .campaign-window .registry-item { padding: 10px 8px; }\n  .campaign-window .window-map-link { width: 100%; }\n}\n"],["STYLE",{},"/* Hearth & Card's reviewed materials, copied unchanged. DOM only: no atlas,\n   geometry, visibility, scrolling or command behavior belongs to this sheet. */\n.application {\n  --hearth-ink: #352619;\n  --hearth-text: #f0dfb7;\n  --hearth-muted: #c5b89b;\n  --hearth-brass: #c5a46a;\n  --hearth-edge: #8a704b;\n  --hearth-paper: linear-gradient(#ead8b3e6, #ead8b3e6), url('/ui/hearth-card/parchment.webp');\n  --hearth-wood: linear-gradient(#261a13dc, #261a13dc), url('/ui/hearth-card/wood.webp');\n  --hearth-leather: linear-gradient(120deg, #35261d, #251b15);\n  --parchment: var(--hearth-text);\n  --muted: var(--hearth-muted);\n  --line: #68553d;\n  --gold: var(--hearth-brass);\n  color: var(--hearth-text);\n  background-color: #1b1713;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  color-scheme: dark;\n}\n\n.application .developer-updates-link { color: var(--hearth-brass); }\n.application .developer-updates-link:hover { color: var(--hearth-text); }\n.application .developer-updates-link:focus-visible { outline: 2px solid var(--hearth-brass); outline-offset: 4px; }\n\n.application :is(h1, h2, h3, h4, .section-title, .campaign-brand) {\n  font-family: Georgia, 'Times New Roman', serif;\n  color: #efdbad;\n}\n.application :is(button, input, select, textarea) {\n  font-family: inherit;\n}\n.application :is(.campaign-topbar, .command-bar, .hud-tools, .campaign-window,\n  .masthead, .campaign-tools, .campaign-options, .options-content, .art-dev-launch, .panel, .map-actions,\n  .chronicles-dialog, .progression-dialog, .character-dialog) {\n  color: var(--hearth-text);\n  background-color: #302119;\n  background-image: var(--hearth-wood);\n  background-size: auto, 512px 512px;\n  border-color: var(--hearth-edge);\n}\n.application :is(.campaign-window, .map-actions, .chronicles-dialog,\n  .progression-dialog, .character-dialog, .setup) {\n  border: 3px double #bfa068;\n  border-radius: 9px;\n  box-shadow: inset 0 0 0 2px #17110c, 0 12px 32px #0008;\n  scrollbar-color: #a48a5e #271d16;\n}\n.application :is(.campaign-window-header, .map-actions-heading, .map-actions-footer) {\n  background-color: #302119;\n  background-image: var(--hearth-leather);\n  color: var(--hearth-text);\n  border-color: var(--hearth-edge);\n}\n/* Layout reserves space for this one decorative, non-interactive corner.\n   It is the original static idle image, not an invented animation. */\n.application .campaign-window-header {\n  background-image: url('/ui/hearth-card/ornament.corner-idle.webp'), var(--hearth-leather);\n  background-repeat: no-repeat;\n  background-position: right top, center;\n  background-size: 48px 48px, auto;\n}\n.application :is(.campaign-window-header, .map-actions-heading, .chronicles-header) :is(h1, h2) {\n  color: #efdbad;\n  text-shadow: 0 1px 2px #0008;\n}\n.application :is(.chronicles-dialog, .progression-dialog, .character-dialog)::backdrop {\n  background-color: #130f0bcc;\n}\n\n/* A quiet leather surface keeps dense rules and quoted costs readable.\n   Do not recolor faction crests, unit art, the world canvas or its ownership cues. */\n.application :is(.campaign-window-body, .map-actions-body, .production-category,\n  .production-card, .progression-choice, .character-promotion, .character-mission,\n  .skill-roadmap, .public-project, .border-growth, .peace-builder, .peace-offer,\n  .capture-option, .battle-panel, .battle-history, .battle-report,\n  .battlefield-inspection, .battlefield-ability-list article,\n  .route-preview, .queued-route, .technical-reader) {\n  background-color: #2a2119;\n  background-image: var(--hearth-leather);\n  border-color: #756044;\n  color: var(--hearth-text);\n}\n.application :is(.map-title, .map-legend, .map-order-hint) {\n  background: #241c16ed;\n  border-color: #9b805980;\n  color: var(--hearth-muted);\n}\n.application :is(.resources small, .resources strong span, .turn small,\n  .field-help, .subtle, .empty, .archive-note, .campaign-pace,\n  .map-actions-heading p, .map-actions-choice-summary, .production-card p,\n  .progression-choice p, .character-promotion p, .character-mission p,\n  .character-values dt, .character-pagination span, .registry-item small,\n  .realm-tip p, .chronicle li, .chronicle li small, .stat-pair small,\n  .hex-inspector p, .nearby-cells small, .production-queue small, .build-options small,\n  .route-preview > p, .queued-route > p, .queued-route li,\n  .research-key, .research-root, .progression-explanation,\n  .skill-roadmap > p, .skill-branches button span, .battlefield-context,\n  .battlefield-footnote, .battle-orders small, .battle-autoresolve > p,\n  .battle-report > div > p, .peace-treaties p, .capture-option > p) {\n  color: var(--hearth-muted);\n}\n.application :is(label, summary, .section-title, .resources strong, .stat-pair strong,\n  .character-values dd, .land-stage, .land-tile-total, .production-category > summary) {\n  color: var(--hearth-text);\n}\n.application :is(.eyebrow, .crest, .entity-symbol, .status-mark, .progression-cost) {\n  color: #dcc18b;\n}\n.application :is(.production-category > summary > span, .production-description > summary,\n  .realm-switcher button span, .selection-command small, .registry-tools > span,\n  .registry-pages span, .tabs button span, .character-row small) {\n  color: var(--hearth-muted);\n}\n.application :is(.stat-pair, .chronicle, .chronicle li, .tabs, .map-actions-tabs,\n  .character-skills, .character-appointments, .character-pagination,\n  .faction-encounter, .faction-encounters, .public-projects, .land-panel,\n  .land-cell, .land-option, .land-work, .land-town-overview, .land-tile-facts,\n  .naval-transport, .army-characters, .hex-inspector, .realm-culture,\n  .faction-recruitment, .faction-recruitment li, .save-actions) {\n  border-color: #68553d;\n}\n.application :is(.formation-table th, .formation-table td, .land-yields th, .land-yields td) {\n  border-color: #68553d;\n}\n.application .formation-table thead th {\n  background: #241b14;\n  color: var(--hearth-muted);\n}\n\n/* Embossed plaques. No translation or filtering of nested sprite artwork. */\n.application button,\n.application :is(.map-actions, .campaign, .progression-dialog, .character-dialog,\n  .chronicles-dialog, .campaign-window, .hud-tools, .command-bar, .setup) button {\n  color: var(--hearth-text);\n  background-color: #35261b;\n  background-image: linear-gradient(#ffffff08, #0002), var(--hearth-leather);\n  border-color: #9b7f50;\n  box-shadow: inset 0 1px #ecd6a333, inset 0 -1px #160f09, 0 2px 3px #0004;\n  text-shadow: 0 1px #0005;\n  transition: background-color .16s ease, border-color .16s ease, box-shadow .16s ease;\n}\n.application button:hover:not(:disabled) {\n  color: #fff0cd;\n  background-image: linear-gradient(#cba66720, #0001), var(--hearth-leather);\n  border-color: #e9c176;\n  box-shadow: inset 0 1px #ffe7af55, 0 3px 6px #0005;\n}\n.application button:active:not(:disabled) {\n  box-shadow: inset 0 2px 4px #0007;\n}\n.application button:is(.primary, .end-turn, [aria-selected=true], [aria-pressed=true], .selected),\n.application .progression-dialog button[aria-selected=true],\n.application .character-dialog button[aria-pressed=true] {\n  color: #fff0cd;\n  background-image: linear-gradient(120deg, #694a28, #47301c);\n  border-color: #e9c176;\n  box-shadow: inset 0 0 0 1px #e9c17626, inset 0 1px #ffe7af55, 0 2px 3px #0004;\n}\n.application button:disabled {\n  color: #c8b99a;\n  background-image: linear-gradient(#3d3328, #302820);\n  border-color: #74644c;\n  box-shadow: inset 0 1px #efddb311;\n  opacity: .68;\n}\n.application :is(button, input, select, textarea, summary, a, [tabindex]):focus-visible {\n  outline: 2px solid #f1cd81;\n  outline-offset: 3px;\n}\n.application :is(input, select, textarea) {\n  color: var(--hearth-ink);\n  background: #ead8b3;\n  border-color: #8d7049;\n  box-shadow: inset 0 2px 3px #563d262e;\n  accent-color: #9b7440;\n  color-scheme: light;\n}\n.application :is(input, textarea)::placeholder {\n  color: #705b40;\n  opacity: 1;\n}\n.application select option {\n  color: var(--hearth-ink);\n  background: #ead8b3;\n}\n.application :is(.danger, button.danger) {\n  color: #ffe0c9;\n  background: linear-gradient(#603e2f, #43291f);\n  border-color: #c08964;\n}\n.application :is(.feedback.error, .negotiation-error, .battle-blocker,\n  .land-blocker, .production-card .production-blocker, .character-blocker,\n  .transport-warning, .war-state, .policy-exclusion) {\n  color: #efba98;\n}\n.application :is(.peace-state, .feedback) {\n  color: #d8c8a5;\n}\n.application .feedback.error { color: #efba98; }\n.application .progression-dialog .progression-choice:is([data-state=researched], [data-state=adopted]),\n.application .skill-acquired,\n.application .skill-roadmap button[data-state=learned] {\n  background: linear-gradient(#4c3c27, #35291d);\n  border-color: #c9ac70;\n}\n.application :is(.progression-choice, .character-promotion)[data-state=excluded] {\n  border-color: #b18a70;\n  border-style: dashed;\n}\n\n/* Restrained writing inset: every inherited text tone is dark here; controls\n   retain their own explicit contrast. Broad panel backgrounds stay dark. */\n.application .setup .faction-card {\n  color: var(--hearth-ink);\n  background-image: var(--hearth-paper);\n  background-color: #ead8b3;\n  background-size: auto, 512px 512px;\n  border-color: #8a683f;\n  box-shadow: inset 0 0 0 2px #f8e7bc66, 0 3px 7px #0003;\n}\n.application .setup .faction-card :is(h2, h3, h4, p, small, label, summary,\n  strong, .eyebrow, .field-help, .faction-recruitment li > span) {\n  color: var(--hearth-ink);\n  text-shadow: none;\n}\n.application ::selection { color: #fff4d9; background: #816139; }\n@media (prefers-reduced-motion: reduce) {\n  .application button { transition: none; }\n}\n"]],"\n  ",["BODY",{},["DIV",{"id":"root"},["DIV",{"class":"application","style":"--text-scale: 1;"},["INPUT",{"__playwright_value_":"","class":"file-input","aria-label":"Import save file","accept":".theandril,application/gzip","type":"file"}],["DIV",{"class":"campaign-topbar"},["HEADER",{"class":"masthead"},["DIV",{"class":"wordmark"},["svg",{"class":"crest","viewBox":"0 0 64 76","aria-hidden":"true"},["path",{"d":"M5 5h54v37c0 16-27 28-27 28S5 58 5 42Z","fill":"none","stroke":"currentColor","stroke-width":"1.5"}],["path",{"d":"M16 49h32M22 44l10-28 10 28M26 35h12M32 16V9","fill":"none","stroke":"currentColor","stroke-width":"2"}],["path",{"d":"m13 13 5 3-5 3m38-6-5 3 5 3M27 57h10","fill":"none","stroke":"currentColor"}]],["DIV",{},["SPAN",{"class":"eyeb