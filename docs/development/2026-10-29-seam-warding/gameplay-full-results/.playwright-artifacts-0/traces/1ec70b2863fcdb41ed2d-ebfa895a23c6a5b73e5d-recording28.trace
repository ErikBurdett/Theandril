s summary{cursor:pointer;padding:.4rem 0}.land-option,.land-work{padding:.7rem 0;border-top:1px solid #454838}.land-option p,.land-work p{margin:.4rem 0}.land-blocker{font-size:.82rem;color:#e5bca0}.faction-choice{margin-bottom:1rem}.faction-choice>p{font-size:.86rem}.land-legend{font-size:.75rem}.land-legend span{white-space:normal}@media(max-width:600px){.land-panel{width:100%}.land-yields{font-size:.8rem}.land-tile-list{max-height:16rem}}\n.faction-identity{min-width:0}.faction-identity .faction-profile{font-size:calc(.86rem * var(--text-scale,1));line-height:1.6;margin:.6rem 0}.faction-identity .field-help{margin:.6rem 0}.faction-recruitment,.realm-culture{margin:.8rem 0;border-top:1px solid #454838}.faction-recruitment>summary,.realm-culture>summary{cursor:pointer;min-height:44px;padding:.75rem 0;overflow-wrap:anywhere}.faction-recruitment>p{font-size:calc(.82rem * var(--text-scale,1));line-height:1.6}.faction-recruitment ul{list-style:none;padding:0;font-size:calc(.78rem * var(--text-scale,1))}.faction-recruitment li{display:flex;justify-content:space-between;gap:.75rem;padding:.35rem 0;border-bottom:1px solid #343e34}.faction-recruitment li>span:first-child{min-width:0;overflow-wrap:anywhere}.faction-recruitment li>span:last-child{white-space:nowrap;color:#c8bc99}.faction-choice select{min-height:44px}.faction-identity summary:focus-visible,.realm-culture>summary:focus-visible{outline:2px solid #b9a165;outline-offset:2px}\n.land-panel-compact{margin-top:0;padding-top:0;border-top:0}.land-panel-compact .land-cell{margin-top:.4rem;padding-top:0;border-top:0}.land-panel-compact .land-cell>p{margin:.45rem 0}.land-panel-compact .land-options{margin:.35rem 0}.land-panel-compact .land-options>summary,.land-town-overview>summary,.land-tile-facts>summary{min-height:44px;cursor:pointer;padding:.65rem 0;overflow-wrap:anywhere}.land-panel-compact .land-options>summary:focus-visible,.land-town-overview>summary:focus-visible,.land-tile-facts>summary:focus-visible{outline:2