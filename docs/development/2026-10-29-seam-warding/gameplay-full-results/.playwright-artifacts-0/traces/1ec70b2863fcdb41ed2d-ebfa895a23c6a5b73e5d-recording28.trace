{"type":"before","callId":"call@2297","startTime":87858.442,"class":"Frame","method":"evaluateExpression","params":{"expression":"formationId => {\n    const scene = window.__THEANDRIL__.getBattleDiagnostics(),\n      field = document.querySelector('[data-testid=map-container]').getBoundingClientRect();\n    const soldier = scene.soldiers.find(soldier => soldier.formationId === formationId && soldier.alive && scene.camera.x + soldier.x * scene.camera.zoom > 30 && scene.camera.x + soldier.x * scene.camera.zoom < scene.width - 30 && scene.camera.y + (soldier.y - 20 * soldier.scale) * scene.camera.zoom > 130 && scene.camera.y + (soldier.y - 20 * soldier.scale) * scene.camera.zoom < scene.height - 30);\n    if (!soldier) throw new Error('Focused formation has no visible actual soldier to pick.');\n    return {\n      x: field.left + scene.camera.x + soldier.x * scene.camera.zoom,\n      y: field.top + scene.camera.y + (soldier.y - 20 * soldier.scale) * scene.camera.zoom,\n      formationId: soldier.formationId\n    };\n  }","isFunction":true,"arg":{"value":{"s":"formation.2"},"handles":[]}},"stepId":"pw:api@91"}
