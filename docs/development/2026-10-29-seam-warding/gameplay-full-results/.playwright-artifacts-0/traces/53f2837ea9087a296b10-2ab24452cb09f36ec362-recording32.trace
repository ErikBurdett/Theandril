ement.6"}],"id":768}},{"k":"progression","v":{"o":[{"k":"technologies","v":{"a":[],"id":770}},{"k":"institutionId","v":{"v":"null"}},{"k":"doctrineId","v":{"v":"null"}},{"k":"technologyChoices","v":{"a":[{"o":[{"k":"id","v":{"s":"technology.cinder_masonry"}},{"k":"name","v":{"s":"Cinder masonry"}},{"k":"description","v":{"s":"Reusable kiln forms strengthen hearthland workshops. Every settlement gains 2 industry before devastation, occupation and blockade penalties."}},{"k":"knowledgeCost","v":{"n":24}},{"k":"requires","v":{"a":[],"id":773}},{"k":"branch","v":{"s":"craft"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 24 knowledge."}}],"id":772},{"o":[{"k":"id","v":{"s":"technology.civic_accounts"}},{"k":"name","v":{"s":"Civic accounts"}},{"k":"description","v":{"s":"Public ledgers reconnect the bargains once carried by the Witness Roads. Every settlement gains 1 coin and 1 knowledge before penalties; enables the Hearth Exchange."}},{"k":"knowledgeCost","v":{"n":400}},{"k":"requires","v":{"a":[],"id":775}},{"k":"branch","v":{"s":"civic"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 400 knowledge."}}],"id":774},{"o":[{"k":"id","v":{"s":"technology.coastal_navigation"}},{"k":"name","v":{"s":"Coastal navigation"}},{"k":"description","v":{"s":"Soundings and shore charts reconnect coastal hearthlands. Enables Charter harbors, transports and Coastwatch galleys; vessels can travel coastal shallows. This practical knowledge does not confer magical aptitude."}},{"k":"knowledgeCost","v":{"n":30}},{"k":"requires","v":{"a":[],"id":777}},{"k":"branch","v":{"s":"navigation"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 30 knowledge."}}],"id":776},{"o":[{"k":"id","v":{"s":"technology.ocean_navigation"}},{"k":"name","v":{"s":"Ocean navigation"}},{"k":"description","v":{"s":"Deep-water charts and long-voyage rigging open the ocean. Ocean-capable transports and Deepwake warships may cross deep water; coastal galleys remain restricted to shallows."}},{"k":"knowledgeCost","v":{"n":80}},{"k":"requires","v":{"a":[{"s":"technology.coastal_navigation"}],"id":779}},{"k":"branch","v":{"s":"navigation"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":778},{"o":[{"k":"id","v":{"s":"technology.stewardship"}},{"k":"name","v":{"s":"Seasonal stewardship"}},{"k":"description","v":{"s":"Record planting and water-sharing obligations. Unlocks Spring gardens on fresh-water land; opens the waterworks, forestry and surveyed-estates branches. Knowledge alone does not build or work a tile."}},{"k":"knowledgeCost","v":{"n":36}},{"k":"requires","v":{"a":[],"id":781}},{"k":"branch","v":{"s":"stewardship"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 36 knowledge."}}],"id":780},{"o":[{"k":"id","v":{"s":"technology.waterworks"}},{"k":"name","v":{"s":"Sluice waterworks"}},{"k":"description","v":{"s":"Controlled sluices support worked wetland Polders. They can feed crowded settlements, but old growth and Ashfall glass make intensive planting less productive. Physical terrain and natural features remain intact."}},{"k":"knowledgeCost","v":{"n":64}},{"k":"requires","v":{"a":[{"s":"technology.stewardship"}],"id":783}},{"k":"branch","v":{"s":"stewardship"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":782},{"o":[{"k":"id","v":{"s":"technology.surveyed_estates"}},{"k":"name","v":{"s":"Surveyed estates"}},{"k":"description","v":{"s":"Witnessed boundary surveys add one civic progress per active settlement turn toward automatic border expansion. Claims still require connected, charted land within the settlement’s reach; siege and occupation halt expansion."}},{"k":"knowledgeCost","v":{"n":60}},{"k":"requires","v":{"a":[{"s":"technology.stewardship"}],"id":785}},{"k":"branch","v":{"s":"civic"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":784},{"o":[{"k":"id","v":{"s":"technology.charter_forestry"}},{"k":"name","v":{"s":"Charter forestry"}},{"k":"description","v":{"s":"Bind cutting rights to the preservation of living records. Unlocks Grove archives on old-growth woodland: knowledge and modest industry instead of the woodlot’s stronger extraction."}},{"k":"knowledgeCost","v":{"n":72}},{"k":"requires","v":{"a":[{"s":"technology.stewardship"}],"id":787}},{"k":"branch","v":{"s":"stewardship"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":786},{"o":[{"k":"id","v":{"s":"technology.quarry_cranes"}},{"k":"name","v":{"s":"Counterweighted cranes"}},{"k":"description","v":{"s":"Reusable lifting frames unlock Oreworks on mineral seams. Worked Oreworks favor industry at the cost of food and coin; wet ground complicates extraction."}},{"k":"knowledgeCost","v":{"n":60}},{"k":"requires","v":{"a":[{"s":"technology.cinder_masonry"}],"id":789}},{"k":"branch","v":{"s":"craft"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":788},{"o":[{"k":"id","v":{"s":"technology.deep_soundings"}},{"k":"name","v":{"s":"Deep soundings"}},{"k":"description","v":{"s":"Observations from the shore compare returning ships’ ocean records. Unlocks Tide observatories on coastal shallows; knowledge replaces the food-focused role of a fishery. Does not extend worker reach into deep ocean."}},{"k":"knowledgeCost","v":{"n":120}},{"k":"requires","v":{"a":[{"s":"technology.ocean_navigation"}],"id":791}},{"k":"branch","v":{"s":"navigation"}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Research the prerequisite technologies."}}],"id":790}],"id":771}},{"k":"institutionChoices","v":{"a":[{"o":[{"k":"id","v":{"s":"institution.charter_compact"}},{"k":"name","v":{"s":"Charter compact"}},{"k":"description","v":{"s":"Recognize shared market charters. Every settlement gains 2 coin before penalties; enables the Hearth Exchange. Permanently excludes Common stewardship."}},{"k":"coinCost","v":{"n":30}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 30 coin."}}],"id":793},{"o":[{"k":"id","v":{"s":"institution.common_stewardship"}},{"k":"name","v":{"s":"Common stewardship"}},{"k":"description","v":{"s":"Communal stores take priority over merchant privileges. Every settlement gains 3 food before penalties; enables the Hearth Exchange. Permanently excludes Charter compact."}},{"k":"coinCost","v":{"n":30}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 30 coin."}}],"id":794}],"id":792}},{"k":"doctrineChoices","v":{"a":[{"o":[{"k":"id","v":{"s":"doctrine.shield_cohesion"}},{"k":"name","v":{"s":"Shield cohesion"}},{"k":"description","v":{"s":"Train formations to cover one another. Armies gain 2 armor in battle. Permanently excludes March columns."}},{"k":"coinCost","v":{"n":24}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 24 coin."}}],"id":796},{"o":[{"k":"id","v":{"s":"doctrine.march_columns"}},{"k":"name","v":{"s":"March columns"}},{"k":"description","v":{"s":"Organize disciplined marching relays. Armies regain 1 additional strategic movement each turn. Permanently excludes Shield cohesion."}},{"k":"coinCost","v":{"n":24}},{"k":"available","v":{"b":false}},{"k":"blocker","v":{"s":"Requires 24 coin."}}],"id":797}],"id":795}},{"k":"project","v":{"o":[{"k":"id","v":{"s":"project.hearth_exchange"}},{"k":"name","v":{"s":"Hearth Exchange"}},{"k":"description","v":{"s":"Host a great exchange supported by three settlements with Charter markets and Witness archives. Sustain its full active period; blockades and conquest can interrupt the endeavor. Funding and duration depend on campaign pace."}},{"k":"coinCost","v":{"n":18000}},{"k":"activeTurns","v":{"n":20}},{"k":"eligibleSettlementIds","v":{"a":[],"id":799}},{"k":"blockers","v":{"a":[{"s":"Research Civic accounts."},{"s":"Adopt an institution."},{"s":"Maintain 3 unoccupied settlements, each with a Charter market and Witness archive."},{"s":"Requires 18000 coin upfront; cancellation gives no refund."},{"s":"A prepared host settlement must be free of siege and occupation."}],"id":800}}],"id":798}},{"k":"unification","v":{"o":[{"k":"id","v":{"s":"victory.unification"}},{"k":"name","v":{"s":"Unification"}},{"k":"description","v":{"s":"Hold more than two thirds of all hearths in the world, and your own capital, through the pace’s public response window. Losing that hold or the capital ends the bid; rivals can retake hearths or strike the capital."}},{"k":"requiredTurns","v":{"n":20}},{"k":"held","v":{"n":1}},{"k":"own","v":{"n":1}},{"k":"pledged","v":{"n":0}},{"k":"total","v":{"n":2}},{"k":"minimum","v":{"n":8}},{"k":"blockers","v":{"a":[{"s":"Hold at least 8 hearths (you hold 1)."},{"s":"Hold more than two thirds of all 2 hearths (you hold 1)."}],"id":802}}],"id":801}},{"k":"attunementAvailable","v":{"b":true}}],"id":769}},{"k":"projects","v":{"a":[],"id":803}},{"k":"victory","v":{"v":"null"}},{"k":"pendingCapture","v":{"v":"null"}},{"k":"ruins","v":{"a":[],"id":804}},{"k":"cells","v":{"a":[],"id":805}},{"k":"campaign","v":{"o":[{"k":"mode","v":{"s":"player"}},{"k":"coverage","v":{"s":"from-save"}}],"id":806}},{"k":"watch","v":{"o":[{"k":"enabled","v":{"b":false}},{"k":"running","v":{"b":false}},{"k":"fogEnabled","v":{"b":true}}],"id":807}},{"k":"ownArmies","v":{"a":[{"ref":123}],"id":808}},{"k":"ownSettlements","v":{"a":[{"ref":337}],"id":809}},{"k":"exploredCells","v":{"n":61}}],"id":1}}}
