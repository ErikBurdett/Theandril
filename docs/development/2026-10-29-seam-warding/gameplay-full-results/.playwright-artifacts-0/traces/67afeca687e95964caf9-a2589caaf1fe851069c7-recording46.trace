},"Victory"]],["SECTION",{"class":"progression-panel","role":"tabpanel","id":"progression-panel","aria-labelledby":"progression-technology-tab"},["P",{"class":"progression-explanation"},"Spend accumulated knowledge on permanent practical discoveries. Their effects add to the realm’s existing capabilities."],["SECTION",{"aria-label":"Research tree","data-testid":"research-tree"},["P",{"class":"research-key"},"◆ Researched · ◇ Available · ⊘ Locked. Follow the prerequisite links to plan a route; inspection never spends knowledge."],["NAV",{"aria-label":"Research branches","class":"research-branch-links"},["BUTTON",{"type":"button"},"Craft & construction"],["BUTTON",{"type":"button"},"Civic knowledge"],["BUTTON",{"type":"button"},"Navigation"],["BUTTON",{"type":"button"},"Land stewardship"]],["DIV",{"class":"research-lanes"},["SECTION",{"class":"research-lane","aria-label":"Craft & construction research"},["H3",{},"Craft & construction"],["OL",{},["LI",{"data-depth":"0"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.cinder_masonry","data-state":"available","tabindex":"-1","aria-label":"Cinder masonry discovery"},["SPAN",{"class":"research-node-status"},"◇"," ","Available"," · ","Root discovery"],["H4",{},"Cinder masonry"],["P",{},"Reusable kiln forms strengthen hearthland workshops. Every settlement gains 2 industry before devastation, occupation and blockade penalties."],["P",{"class":"research-root"},"No discovery prerequisite."],["SPAN",{"class":"progression-cost"},"24"," knowledge"],["BUTTON",{"class":"primary wide","aria-label":"Research Cinder masonry"},"Research discovery"]]],["LI",{"data-depth":"1"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.quarry_cranes","data-state":"locked","tabindex":"-1","aria-label":"Counterweighted cranes discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Stage 2"],["H4",{},"Counterweighted cranes"],["P",{},"Reusable lifting frames unlock Oreworks on mineral seams. Worked Oreworks favor industry at the cost of food and coin; wet ground complicates extraction."],["DIV",{"class":"research-prerequisites"},["SPAN",{},"Requires all:"],["BUTTON",{"type":"button","aria-label":"View prerequisite Cinder masonry"},"Cinder masonry"," · ","not researched"]],["SPAN",{"class":"progression-cost"},"60"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.quarry_cranes"},"Research the prerequisite technologies."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.quarry_cranes","aria-label":"Research Counterweighted cranes"},"Research discovery"]]]]],["SECTION",{"class":"research-lane","aria-label":"Civic knowledge research"},["H3",{},"Civic knowledge"],["OL",{},["LI",{"data-depth":"0"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.civic_accounts","data-state":"locked","tabindex":"-1","aria-label":"Civic accounts discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Root discovery"],["H4",{},"Civic accounts"],["P",{},"Public ledgers reconnect the bargains once carried by the Witness Roads. Every settlement gains 1 coin and 1 knowledge before penalties; enables the Hearth Exchange."],["P",{"class":"research-root"},"No discovery prerequisite."],["SPAN",{"class":"progression-cost"},"400"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.civic_accounts"},"Requires 400 knowledge."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.civic_accounts","aria-label":"Research Civic accounts"},"Research discovery"]]],["LI",{"data-depth":"1"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.surveyed_estates","data-state":"locked","tabindex":"-1","aria-label":"Surveyed estates discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Stage 2"],["H4",{},"Surveyed estates"],["P",{},"Witnessed boundary surveys add one civic progress per active settlement turn toward automatic border expansion. Claims still require connected, charted land within the settlement’s reach; siege and occupation halt expansion."],["DIV",{"class":"research-prerequisites"},["SPAN",{},"Requires all:"],["BUTTON",{"type":"button","aria-label":"View prerequisite Seasonal stewardship"},"Seasonal stewardship"," · ","not researched"]],["SPAN",{"class":"progression-cost"},"60"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.surveyed_estates"},"Research the prerequisite technologies."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.surveyed_estates","aria-label":"Research Surveyed estates"},"Research discovery"]]]]],["SECTION",{"class":"research-lane","aria-label":"Navigation research"},["H3",{},"Navigation"],["OL",{},["LI",{"data-depth":"0"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.coastal_navigation","data-state":"available","tabindex":"-1","aria-label":"Coastal navigation discovery"},["SPAN",{"class":"research-node-status"},"◇"," ","Available"," · ","Root discovery"],["H4",{},"Coastal navigation"],["P",{},"Soundings and shore charts reconnect coastal hearthlands. Enables Charter harbors, transports and Coastwatch galleys; vessels can travel coastal shallows. This practical knowledge does not confer magical aptitude."],["P",{"class":"research-root"},"No discovery prerequisite."],["SPAN",{"class":"progression-cost"},"30"," knowledge"],["BUTTON",{"class":"primary wide","aria-label":"Research Coastal navigation"},"Research discovery"]]],["LI",{"data-depth":"1"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.ocean_navigation","data-state":"locked","tabindex":"-1","aria-label":"Ocean navigation discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Stage 2"],["H4",{},"Ocean navigation"],["P",{},"Deep-water charts and long-voyage rigging open the ocean. Ocean-capable transports and Deepwake warships may cross deep water; coastal galleys remain restricted to shallows."],["DIV",{"class":"research-prerequisites"},["SPAN",{},"Requires all:"],["BUTTON",{"type":"button","aria-label":"View prerequisite Coastal navigation"},"Coastal navigation"," · ","not researched"]],["SPAN",{"class":"progression-cost"},"80"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.ocean_navigation"},"Research the prerequisite technologies."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.ocean_navigation","aria-label":"Research Ocean navigation"},"Research discovery"]]],["LI",{"data-depth":"2"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.deep_soundings","data-state":"locked","tabindex":"-1","aria-label":"Deep soundings discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Stage 3"],["H4",{},"Deep soundings"],["P",{},"Observations from the shore compare returning ships’ ocean records. Unlocks Tide observatories on coastal shallows; knowledge replaces the food-focused role of a fishery. Does not extend worker reach into deep ocean."],["DIV",{"class":"research-prerequisites"},["SPAN",{},"Requires all:"],["BUTTON",{"type":"button","aria-label":"View prerequisite Ocean navigation"},"Ocean navigation"," · ","not researched"]],["SPAN",{"class":"progression-cost"},"120"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.deep_soundings"},"Research the prerequisite technologies."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.deep_soundings","aria-label":"Research Deep soundings"},"Research discovery"]]]]],["SECTION",{"class":"research-lane","aria-label":"Land stewardship research"},["H3",{},"Land stewardship"],["OL",{},["LI",{"data-depth":"0"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.stewardship","data-state":"available","tabindex":"-1","aria-label":"Seasonal stewardship discovery"},["SPAN",{"class":"research-node-status"},"◇"," ","Available"," · ","Root discovery"],["H4",{},"Seasonal stewardship"],["P",{},"Record planting and water-sharing obligations. Unlocks Spring gardens on fresh-water land; opens the waterworks, forestry and surveyed-estates branches. Knowledge alone does not build or work a tile."],["P",{"class":"research-root"},"No discovery prerequisite."],["SPAN",{"class":"progression-cost"},"36"," knowledge"],["BUTTON",{"class":"primary wide","aria-label":"Research Seasonal stewardship"},"Research discovery"]]],["LI",{"data-depth":"1"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.charter_forestry","data-state":"locked","tabindex":"-1","aria-label":"Charter forestry discovery"},["SPAN",{"class":"research-node-status"},"⊘"," ","Locked"," · ","Stage 2"],["H4",{},"Charter forestry"],["P",{},"Bind cutting rights to the preservation of living records. Unlocks Grove archives on old-growth woodland: knowledge and modest industry instead of the woodlot’s stronger extraction."],["DIV",{"class":"research-prerequisites"},["SPAN",{},"Requires all:"],["BUTTON",{"type":"button","aria-label":"View prerequisite Seasonal stewardship"},"Seasonal stewardship"," · ","not researched"]],["SPAN",{"class":"progression-cost"},"72"," knowledge"],["P",{"class":"progression-blocker","id":"blocker-technology.charter_forestry"},"Research the prerequisite technologies."],["BUTTON",{"class":"primary wide","disabled":"","aria-describedby":"blocker-technology.charter_forestry","aria-label":"Research Charter forestry"},"Research discovery"]]],["LI",{"data-depth":"1"},["ARTICLE",{"class":"progression-choice research-node","data-testid":"progression-technology.waterworks","data-state":"locked","tabindex":"-1","aria-label":"Sluice waterworks discovery"},["SPAN",{"class":