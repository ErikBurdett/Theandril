{
  "scope": "Current local typecheck/lint/content/build only. No AI/contact tests, blocked probes, installs, publication or full-release acceptance.",
  "stages": [
    {
      "stage": "typecheck",
      "command": "pnpm typecheck",
      "exitCode": 0,
      "error": null,
      "log": "docs/development/ui-review-current/parent-typecheck.log"
    },
    {
      "stage": "lint",
      "command": "pnpm lint",
      "exitCode": 0,
      "error": null,
