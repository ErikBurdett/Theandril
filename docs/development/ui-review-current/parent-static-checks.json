    },
    {
      "stage": "content",
      "command": "pnpm content:validate",
      "exitCode": 0,
      "error": null,
      "log": "docs/development/ui-review-current/parent-content.log"
    },
    {
      "stage": "build",
      "command": "pnpm build",
      "exitCode": 0,
      "error": null,
      "log": "docs/development/ui-review-current/parent-build.log"
    }
  ]
}
