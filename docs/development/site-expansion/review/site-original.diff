+/* eslint-disable @typescript-eslint/no-explicit-any */
+import { StrictMode, useState, type CSSProperties } from 'react';
+import { createRoot } from 'react-dom/client';
+import { SiteShell } from './SiteShell';
+import { evidenceUrl, localUrl } from './journal';
+import { factionLoreUrl } from './cross-links';
+import { resolveCulture, resolveUnit } from './compendium-routes';
+import data from './compendium/data.json';
+import './journal.css';
+import './compendium.css';
+
+type Asset = { atlasId: string; nativeResolution: { width: number; height: number }; frame: { x: number; y: number; w: number; h: number }; provenance: string };
+type Item = { id: string; name: string; description?: string; [key: string]: any };
+const book = data as any;
+const factions: Item[] = book.factions;
+const byId = (items: Item[], id: string) => items.find(item => item.id === id);
+const shortId = (id: string) => id.replace(/^[^.]+\./, '');
+const atlas = (id: string) => book.atlases.find((entry: any) => entry.id === id);
+
+function Sprite({ assetId, alt, className = '', scale = 2 }: { assetId: string; alt: string; className?: string; scale?: number }) {
+  const asset: Asset | undefined = book.assets[assetId];
+  if (!asset) return <span className={`sprite sprite-missing ${className}`} role="img" aria-label={`${alt}; no published sprite`} title="No published sprite">—</span>;
+  const page = atlas(asset.atlasId);
+  const style = {
+    width: asset.frame.w * scale, height: asset.frame.h * scale,
+    backgroundImage: `url("${localUrl(import.meta.env.BASE_URL, page.imageUrl.replace(/^\//, ''))}")`,
+    backgroundPosition: `${-asset.frame.x * scale}px ${-asset.frame.y * scale}px`,
+    backgroundSize: `${page.width * scale}px ${page.height * scale}px`,
+  } as CSSProperties;
+  return <span className={`sprite ${className}`} data-sprite data-atlas={localUrl(import.meta.env.BASE_URL, page.imageUrl.replace(/^\//, ''))} role="img" aria-label={alt} title={`Provenance: ${asset.provenance}`} style={style} />;
+}
+function Link({ href, children }: { href: string; children: React.ReactNode }) { return <a href={href}>{children}</a>; }
+function Heading({ eyebrow, title, children }: { eyebrow: string; title: string; children?: React.ReactNode }) { return <header className="compendium-hero"><p className="eyebrow">{eyebrow}</p><h1>{title}</h1>{children}</header>; }
+function Stat({ label, value }: { label: string; value: any }) { return <div><dt>{label}</dt><dd>{typeof value === 'boolean' ? (value ? 'Yes' : 'No') : value ?? '—'}</dd></div>; }
+function UnitStats({ unit, compact = false }: { unit: Item; compact?: boolean }) { return <dl className={compact ? 'stat-line' : 'stats'}><Stat label="Industry" value={`${unit.cost} industry`} /><Stat label="Coin" value={unit.coinCost} /><Stat label="Upkeep" value={unit.upkeep} />{!compact && <><Stat label="Move" value={unit.movement} /><Stat label="Sight" value={unit.sight} /><Stat label="Strength" value={unit.strength} /><Stat label="Attack" value={unit.attack} /><Stat label="Armor" value={unit.armor} /><Stat label="Initiative" value={unit.initiative} /><Stat label="Range" value={unit.range} /><Stat label="Morale" value={unit.morale} /><Stat label="Naval" value={unit.naval ? `${unit.naval.transportCapacity} carry; ${unit.naval.oceanCapable ? 'ocean' : 'coastal'}` : 'No'} /></>}</dl> }
+function CultureCard({ faction }: { faction: Item }) { const culture = shortId(faction.id); return <article className="culture-card" data-culture-card><div><Sprite assetId={`ui.crest.${culture}`} alt={`${faction.name} crest`} /><Sprite assetId={`ui.banner.${culture}`} alt={`${faction.name} banner`} /></div><h3><Link href={`?culture=${culture}`}>{faction.name}</Link></h3><p className="motto">“{faction.motto}”</p><p>{faction.profile.description}</p></article>; }
+function UnitCard({ unit, culture }: { unit: Item; culture?: string }) { const mapId = culture ? `${unit.id}.${culture}` : undefined; const assetId = mapId && book.assets[mapId] ? mapId : `battle.${unit.id}`; return <article className="unit-card" data-unit-card><Sprite assetId={assetId} alt={`${unit.name}${culture ? `, ${culture}` : ''}`} scale={1.5} /><div><h3><Link href={`?unit=${shortId(unit.id)}`}>{unit.name}</Link></h3><p>{unit.description ?? 'A standard formation in the published rules.'}</p>{culture && !book.assets[mapId!] && <span className="status-label">Shared battle sprite</span>}<UnitStats unit={unit} compact /></div></article>; }
+function CatalogSection({ title, items, prefix, copy }: { title: string; items: Item[]; prefix: string; copy?: string }) { return <section className="catalog-section"><div className="section-heading"><div><p className="eyebrow">World inventory</p><h2>{title}</h2></div>{copy && <p>{copy}</p>}</div><div className="catalog-grid">{items.map(item => <article className="catalog-card" key={item.id}><Sprite assetId={item.spriteId ?? (book.assets[item.id] ? item.id : `${prefix}${shortId(item.id)}`)} alt={item.name} /><h3>{item.name}</h3><p>{item.description ?? item.id}</p>{item.spriteNote && <span className="status-label">{item.spriteNote}</span>}</article>)}</div></section>; }
+function Overview({ query, onQuery }: { query: string; onQuery: (value: string) => void }) { const q = query.toLowerCase(); const matches = (item: Item) => !q || JSON.stringify(item).toLowerCase().includes(q); const shownFactions = factions.filter(matches); const all = (items: Item[]) => items.filter(matches); return <><Heading eyebrow="The published world" title="Theandril World Compendium"><p className="subtitle">A source-derived index of cultures, rules content and approved atlas art. Numbers are projected at build time from the live content package.</p></Heading><section className="archive-tools"><label className="search-field">Search the compendium<input role="searchbox" aria-label="Search the compendium" value={query} onChange={event => { onQuery(event.target.value); setQuery(event.target.value); }} placeholder="Culture, unit, resource, spell…" /></label></section><section className="catalog-section"><div className="section-heading"><div><p className="eyebrow">24 registered cultures</p><h2>Cultures</h2></div><p>Every culture has a reviewed crest and banner in the published atlas.</p></div><div className="culture-grid">{shownFactions.map(faction => <CultureCard faction={faction} key={faction.id} />)}</div></section><section className="catalog-section"><div className="section-heading"><div><p className="eyebrow">Paid formations</p><h2>Units</h2></div><p>Shared stats and costs are shown exactly as content defines them.</p></div><div className="unit-grid">{all(book.units).map(unit => <UnitCard unit={unit} key={unit.id} />)}</div></section><CatalogSection title="Buildings" items={all(book.buildings)} prefix="building." /><CatalogSection title="Improvements & features" items={[...all(book.improvements), ...all(book.features)]} prefix="improvement." /><CatalogSection title="Resources" items={all(book.resources)} prefix="resource." /><CatalogSection title="Creatures" items={all((Object.values(book.assets) as Item[]).filter((asset: any) => asset.id?.startsWith?.('monster.')))} prefix="" copy="Only published monster art is listed; it does not add hidden creature rules." /><CatalogSection title="Terrain" items={all(book.biomes.map((biome: any) => ({ id: `terrain.${['ocean','grassland','temperate_forest','taiga','tundra','desert','steppe','marsh','rainforest','alpine','ash_scrub','chalkland'][biome.id]}`, name: biome.name, description: `Base yield: food ${biome.yields.food}, industry ${biome.yields.industry}, coin ${biome.yields.coin}, knowledge ${biome.yields.knowledge}.` })))} prefix="" /><CatalogSection title="Characters & missions" items={[...all(book.characters).map((item: Item) => ({ ...item, spriteId: book.assets[item.id] ? item.id : `${item.id}.ashen_compact`, spriteNote: book.assets[item.id] ? undefined : "Shown in Ashen Compact colours; every culture has its own." })), ...all(book.missions)]} prefix="character." copy="Officers are appointed per culture; missions are orders, not units." /><CatalogSection title="Magic" items={[...all(book.magicPaths), ...all(book.arcaneDiscoveries), ...all(book.battleSpells), ...all(book.innateBattleAbilities)]} prefix="effect." copy="Faction-specific spells, supernatural powers and asymmetry are not implemented where the faction bible marks them as lore-only." /></>;
+}
+function CulturePage({ faction }: { faction: Item }) { const culture = shortId(faction.id); const ecology = faction.ecology; const named = (id: string) => book.biomes.find((b: any) => b.id === id)?.name ?? String(id); return <><Heading eyebrow="Culture register" title={faction.name}><div className="culture-hero-art"><Sprite assetId={`ui.crest.${culture}`} alt={`${faction.name} crest`} /><Sprite assetId={`ui.banner.${culture}`} alt={`${faction.name} banner`} /><Sprite assetId={`ui.badge.${culture}`} alt={`${faction.name} badge`} /></div><p className="motto">“{faction.motto}”</p><p>{faction.profile.description}</p><p className="status-label">{faction.profile.recruitmentRationale}</p><p><Link href={factionLoreUrl(import.meta.env.BASE_URL, faction.id)}>Read this culture in the faction bible ↗</Link></p></Heading><section className="catalog-section"><h2>Ecology</h2><p>Terraform biomes: {ecology.terraformBiomeIds.map(named).join(', ')}.</p><dl className="affinities">{ecology.affinities.map((affinity: any) => <div key={affinity.biomeId}><dt>{named(affinity.biomeId)}</dt><dd>Food {affinity.yields.food}, industry {affinity.yields.industry}, coin {affinity.yields.coin}, knowledge {affinity.yields.knowledge}</dd></div>)}</dl></section><section className="catalog-section"><h2>Recruitment preferences</h2><p className="status-label">Preference only — all cultures pay the same costs and may recruit the same units.</p><dl className="weights">{book.landMilitaryUnitIds.map((id: string) => <div key={id}><dt>{byId(book.units, id)?.name}</dt><dd>{faction.recruitmentWeights[id]}</dd></div>)}</dl></section><section className="catalog-section"><h2>Full unit roster</h2><div className="unit-grid">{book.units.map((unit: Item) => <UnitCard unit={unit} culture={culture} key={unit.id} />)}</div></section><section className="catalog-section"><h2>Characters and settlements</h2><div className="catalog-grid">{['marshal','surveyor','engineer'].map(role => <article className="catalog-card" key={role}><Sprite assetId={`character.${role}.${culture}`} alt={`${faction.name} ${role}`} /><h3>{byId(book.characters, `character.${role}`)?.name}</h3></article>)}{['village','town','city'].map(stage => <article className="catalog-card" key={stage}><Sprite assetId={`settlement.${stage}.${culture}`} alt={`${faction.name} ${stage}`} /><h3>{stage}</h3></article>)}</div></section></> }
+function UnitPage({ unit }: { unit: Item }) { const tech = (id: string) => byId(book.technologies, id)?.name ?? id; const building = (id: string) => byId(book.buildings, id)?.name ?? id; return <><Heading eyebrow="Formation register" title={unit.name}><p>{unit.description ?? 'A published standard formation.'}</p>{unit.introducedInRules && <span className="plaque">Introduced in rules {unit.introducedInRules}</span>}</Heading><section className="catalog-section"><h2>Exact statistics</h2><UnitStats unit={unit} /></section><section className="catalog-section"><h2>Prerequisites</h2><p>Technologies: {(unit.requiredTechnologies ?? []).map(tech).join(', ') || 'None'}.</p><p>Buildings: {(unit.requiredBuildings ?? []).map(building).join(', ') || 'None'}.</p></section><section className="catalog-section"><h2>Culture variants</h2>{factions.some(faction => book.assets[`${unit.id}.${shortId(faction.id)}`]) ? <div className="variant-grid">{factions.map(faction => <article key={faction.id}><Sprite assetId={`${unit.id}.${shortId(faction.id)}`} alt={`${unit.name}, ${faction.name}`} /><p>{faction.name}</p></article>)}</div> : <p className="status-label">This formation has a shared battle sprite; no culture-specific map sprite is published.</p>}</section></> }
+function setQuery(value: string) { const url = new URL(location.href); if (value) url.searchParams.set('search', value); else url.searchParams.delete('search'); history.replaceState(null, '', url); window.dispatchEvent(new Event('compendium-search')); }
+function App() { const [search, updateSearch] = useState(new URLSearchParams(location.search).get('search') ?? ''); const params = new URLSearchParams(location.search); const culture = params.get('culture'); const unit = params.get('unit'); const currentFaction = resolveCulture(culture) as Item | undefined; const currentUnit = resolveUnit(unit) as Item | undefined; return <SiteShell page="compendium" base={import.meta.env.BASE_URL}>{currentFaction ? <CulturePage faction={currentFaction} /> : currentUnit ? <UnitPage unit={currentUnit} /> : <Overview query={search} onQuery={updateSearch} />}<p className="compendium-provenance">Sprite frames and provenance: <a href={evidenceUrl('apps/web/public/art/catalog.json')}>published art catalog ↗</a></p></SiteShell>; }
+createRoot(document.getElementById('root')!).render(<StrictMode><App /></StrictMode>);
